# PolyPaper Bot — Environment Variable Template
# Copy to .env and fill in real values. NEVER commit .env.

# ═════════════════ CORE ═════════════════
TELEGRAM_BOT_TOKEN=              # from @BotFather
ADMIN_TELEGRAM_ID=               # your numeric Telegram user ID

# ═════════════════ AI PROVIDERS ═════════════════
ANTHROPIC_API_KEY=               # https://console.anthropic.com
GROK_API_KEY=                    # optional — xAI fallback

# ═════════════════ POLYMARKET CLOB ═════════════════
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=
# 2026-04-29 Phase C Bulgu 7: builder fee attribution. Set to your
# Polymarket Builder Code (https://docs.polymarket.com/builders/fees) to
# earn builder fees on bot orders. Leave empty for vanilla orders.
POLYMARKET_BUILDER_CODE=
# ════════════════════════════════════════════════════════════════════════
# POLYMARKET 3-ADDRESS SYSTEM (2026-05-05 Heddas onaylı netleştirme)
# ════════════════════════════════════════════════════════════════════════
# Polymarket'te Rabby/MetaMask ile login yapınca 3 farklı adres oluşur:
#
# 1) PROFILE/SAFE PROXY  — Senin "asıl hesabın" (Gnosis Safe contract).
#    Polymarket UI: Profile sayfasında "Wallet Address" / "Profile Address"
#    Bakiye burada tutulur, trade buradan çıkar.
#    → POLYGON_WALLET = bu adres (funder)
#
# 2) DEPOSIT ADDRESS    — Para göndermek için adres (USDC/pUSD).
#    Polymarket UI: Settings → Deposit ekranında gözüken adres.
#    Polymarket otomatik routing: bu adrese gelen para Safe Proxy'ye geçer.
#    → POLYMARKET_DEPOSIT_ADDRESS (sadece bilgi, kullanıcı transfer için)
#
# 3) RABBY/EOA WALLET   — Senin private key wallet'ın (cüzdan uygulaması).
#    Polymarket Profile sayfasında "Connected Wallet" ya da settings'te.
#    Login için kullanılır, Safe Proxy'nin owner'ıdır.
#    → POLYGON_PRIVATE_KEY = bu cüzdanın PK'si
#
# Karışıklık riski: deposit address'i POLYGON_WALLET'a yazma — yanlış olur.
# Doğru: POLYGON_WALLET = Profile/Safe Proxy address (Polymarket'te "Wallet").
# ════════════════════════════════════════════════════════════════════════
POLYGON_WALLET=                  # Polymarket Profile/Safe Proxy address (NOT deposit)
POLYGON_PRIVATE_KEY=             # Rabby/EOA private key, NEVER share
POLYMARKET_DEPOSIT_ADDRESS=      # (info-only) deposit/transfer adresi
CLOB_SIGNATURE_TYPE=2            # 0=EOA | 1=POLY_PROXY | 2=GNOSIS_SAFE (default)
LIVE_ENABLED=false               # set true only after dry-run

# 2026-05-05 Polymarket Relayer (gasless approve + transfers)
# Setup:
#   1. polymarket.com/settings/api-keys aç
#   2. "Create Relayer API Key" tıkla
#   3. Açılan popup'tan API Key + Address kopyala → buraya yapıştır
# Bot /allowance komutu bu key'leri kullanarak gasless approve yapar
# (Polymarket relayer Polygon gas öder, kullanıcıdan ücretsiz)
RELAYER_API_KEY=                 # UUID format: 019df830-f7b8-...
RELAYER_API_KEY_ADDRESS=         # Relayer key'in sahibi olan EOA (UI'da gözükür)
RELAYER_HOST=https://relayer-v2.polymarket.com

# 2026-05-05 Auto-redeem winning positions (gasless via Relayer)
# Resolved + winning shares otomatik redeem → pUSD'ye dönüşür
# Telegram admin'e notification gelir
AUTO_REDEEM_ENABLED=false        # true = auto-redeem job aktif (5dk interval)
AUTO_REDEEM_INTERVAL_SEC=300     # 5dk default
AUTO_REDEEM_FIRST_SEC=120        # bot start sonrası ilk fetch (2dk gecikme)
AUTO_REDEEM_MIN_VALUE_USD=0.10   # bu değerin altındaki kazanç redeem edilmez (skip)

# 2026-04-29 Polymarket Portfolio (Aşama 1) — gerçek cüzdan view
PORTFOLIO_REFRESH_ENABLED=true   # Her 60s polymarket_portfolio_job
PORTFOLIO_REFRESH_SEC=60         # Refresh interval
PORTFOLIO_REFRESH_FIRST_SEC=30   # Bot start sonrası ilk fetch
PORTFOLIO_HTTP_TIMEOUT=10.0      # data-api timeout
PORTFOLIO_FAIL_ALERT_THRESHOLD=5 # Sıralı fail count for admin Telegram alert
PORTFOLIO_ALERT_COOLDOWN_SEC=1800 # Admin alert spam koruması (30dk)
POLYMARKET_DATA_API=https://data-api.polymarket.com  # Override için
POLYMARKET_CLOB_HOST=https://clob.polymarket.com

# ═════════════════ POLYBACKTEST ═════════════════
POLYBACKTEST_API_KEY=

# ═════════════════ CHAINLINK PARITY GATE (Phase 47b) ═════════════════
CHAINLINK_ORACLE_ENABLED=false
CHAINLINK_PARITY_BPS=30

# ═════════════════ RISK LIMITS (Phase 47f.8) ═════════════════
MAX_DAILY_LOSS=50
MAX_DAILY_TRADES=200
MAX_LOSS_STREAK=10
MAX_TOTAL_EXPOSURE=100

# ═════════════════ KELLY SIZING ═════════════════
KELLY_BANKROLL_MIN=100
KELLY_BANKROLL_MAX=1000

# Becker calibrator removed 2026-04-28 (Heddas direktifi: tam silme).
# Kaldırılan sekmeler: BECKER_CALIB_ENABLED, BECKER_CALIB_WEIGHT,
# BECKER_CALIB_CLAMP, BECKER_DECISION_MODE, BECKER_DECISION_THRESHOLD,
# BECKER_KALSHI_WEIGHT, ADAPTIVE_BECKER_WEIGHT_ENABLED.
ADAPTIVE_MICRO_WEIGHT_ENABLED=false

# ═════════════════ 2D SURFACE CALIBRATION (Phase 82e Sprint X) ═════════════════
# 2D probability surface calibration — complements 1D Becker with
# price × time_to_expiry (or similar 2-axis) empirical surface.
# See calibration/surface_2d.py.
SURFACE_2D_ENABLED=true                 # Master toggle (default ON)
SURFACE_2D_WEIGHT=0.12                  # Weight in signal boost (≈1D)
SURFACE_2D_CLAMP=0.20                   # Max absolute boost (abs cap)

# ═════════════════ EDGE ZONE FILTER (50-65c zone) ═════════════════
# Minimum confidence floor for trades in 50-65c zone (flat/chop region).
# Raise to 0.60+ for stricter signal requirement in mid-zone.
EDGE_ZONE_5065_MIN=0.45

# ═════════════════ MAKER REBATE (Phase 47f.9) ═════════════════
MAKER_REBATE_ENABLED=true

# ═════════════════ DB RETENTION (Phase 47f.8 + Phase 57) ═════════════════
# Phase 57: MODE controls what happens to old data:
#   "report"  — count old rows, report sizes, DELETE NOTHING (default)
#   "archive" — move old rows to data_store/archives/ monthly DB, then delete
#   "delete"  — legacy: prune old rows and VACUUM
DB_RETENTION_MODE=report
DB_RETENTION_FIRST_SEC=60
DB_RETENTION_INTERVAL_SEC=86400
DB_RETENTION_NOTIFY=true
DB_RETENTION_VACUUM_ENABLED=true

# ═════════════════ DATA RECORDING (Phase 57) ═════════════════
MAX_OB_LEVELS=50                     # L2 orderbook depth (20 → 50)

# ═════════════════ OBSERVABILITY (Phase 48) ═════════════════
SENTRY_DSN=                      # optional — blank = disabled
SENTRY_ENVIRONMENT=production

# ═════════════════ CANARY DEPLOY (Phase 47f.10) ═════════════════
CANARY_SIZE_MULT=0.25
PROMOTE_MIN_TRADES=30
PROMOTE_MIN_PNL=0.0

# ═════════════════ SHADOW COMPARISON (Phase 47f.10 P5#22) ═════════════════
SHADOW_COMPARE_WINDOW_H=24
SHADOW_COMPARE_PNL_ALERT=5.0
SHADOW_COMPARE_WR_ALERT=15.0
SHADOW_COMPARE_MIN_TRADES=10

# ═════════════════ WHALE DETECTION (Phase 47f.10 P4#19) ═════════════════
WHALE_USD_THRESHOLD=1000

# ═════════════════ FORCED EXIT (Phase 53b) ═════════════════
# Close open positions N seconds before market end. 0 = disabled.
# Recommended: 10-15 for 5m markets, 30 for 15m markets.
FORCE_EXIT_SECONDS=0

# ═════════════════ SMART EXIT (Phase 60) ═════════════════
SMART_EXIT_ENABLED=true          # 3-tier smart exit using Becker δ(p)
REMAINING_EDGE_MIN=0.05          # Exit if Becker δ < this (edge exhausted)
STOP_LOSS_DELTA=0.12             # Exit if est_prob < entry - this (wrong side)
DISPOSITION_TRACKING=true        # Track peak unrealized PnL per position

# ═════════════════ CALENDAR MULTIPLIER (Phase 60) ═════════════════
CALENDAR_MULT_ENABLED=true       # Weekend/time-of-day edge multiplier
MAX_CALENDAR_MULT=2.5            # Max multiplier cap (prevent over-sizing)
WEEKEND_SAT_MULT=2.4             # Saturday multiplier
WEEKEND_SUN_MULT=2.1             # Sunday pre-18:00 UTC multiplier

# ═════════════════ OPTIMISM TAX (Phase 60) ═════════════════
OPTIMISM_TAX_ENABLED=true        # NO-side maker structural edge (+0.48%)
OPTIMISM_TAX_TICKS=1             # Extra ticks of aggression on NO-side maker

# ═════════════════ CASCADE OVERSHOOT (Phase 60) ═════════════════

# ═════════════════ WHALE SIGNAL (Phase 60) ═════════════════
WHALE_SIGNAL_ENABLED=true        # Whale flow directional signal
WHALE_USD_THRESHOLD=1000         # Minimum notional for whale ($)
WHALE_SIGNAL_WEIGHT=0.08         # Max signal boost from whale flow
WHALE_WINDOW_SEC=180             # Look-back window (3 min)
WHALE_LATE_MULTIPLIER=2.0        # Boost when near market close

# ═════════════════ LAG ARBITRAGE (Phase 60) ═════════════════

# ═════════════════ ROUND NUMBER CORRECTION (Phase 60) ═════════════════
ROUND_NUMBER_ENABLED=true        # Round number gravity correction signal
ROUND_NUM_ALPHA=0.024            # Gravity strength coefficient
ROUND_NUM_BETA=0.03              # Gravity decay rate

# ═════════════════ ADAPTIVE PNL THRESHOLD (Phase 56-P1) ═════════════════
ADAPTIVE_PNL_ENABLED=true        # Strategies with more trades get more rope
ADAPTIVE_PNL_STEP=0.5            # Loosen threshold by this much per step
ADAPTIVE_PNL_TRADES_PER_STEP=20  # Trades required per loosening step
ADAPTIVE_PNL_FLOOR=-10.0         # Maximum looseness (absolute cap)

# ═════════════════ MARKOV CHAIN ESTIMATOR (Phase 76) ═════════════════
MARKOV_ENABLED=true              # Markov Chain probability boost
MARKOV_N_STATES=10               # Number of discretized price states
MARKOV_N_SIMS=10000              # Monte Carlo simulation paths
MARKOV_LOOKBACK=100              # Historical ticks for transition matrix
MARKOV_HORIZON=30                # Forward prediction horizon (ticks)
MARKOV_WEIGHT=0.20               # Signal weight in composite score
MARKOV_MIN_EDGE=0.03             # Minimum edge to contribute signal

# ═════════════════ CAPITAL ALLOCATOR (Phase 76) ═════════════════

# ═════════════════ BONDING YIELD STRATEGY (Phase 76) ═════════════════
BONDING_MIN_PRICE=0.90           # Min contract price (90c)
BONDING_MAX_PRICE=0.99           # Max contract price (99c)
BONDING_MIN_YIELD=0.01           # Min expected yield (1%)
BONDING_TIME_WEIGHT=true         # Prefer closer-to-resolution contracts
BONDING_MAX_HOURS_LEFT=48        # Max hours until resolution
BONDING_CONFIDENCE_BASE=0.80     # Base confidence for qualifying contracts

# ═════════════════ TRADE MEMORY (Phase 77) ═════════════════
TRADE_MEMORY_ENABLED=true        # Persistent learning from past trades
TRADE_MEMORY_MIN_TRADES=5        # Min trades to form a pattern
TRADE_MEMORY_LOOKBACK_DAYS=30    # How far back to look for patterns
TRADE_MEMORY_BOOST_MAX=0.15      # Max confidence boost from good pattern
TRADE_MEMORY_PENALTY_MAX=0.20    # Max confidence penalty from bad pattern

# ═════════════════ DECISION EXPLAINER (Phase 77) ═════════════════
DECISION_EXPLAINER_ENABLED=true  # Reasoning chains for every trade
DECISION_NOTIFY_DETAIL=medium    # minimal/medium/full notification detail

# ═════════════════ EXPERIMENT RUNNER (Phase 77) ═════════════════
EXPERIMENT_ENABLED=true          # Safe parameter testing sandbox
EXPERIMENT_MAX_PARAMS=5          # Max params per experiment

# ═════════════════ API ROBUSTNESS (Phase 56) ═════════════════
CLOB_TIMEOUT=5.0                 # CLOB REST request timeout (seconds)
MAX_429_RETRIES=3                # Max retries on 429 rate-limit

# ═════════════════ AI BRAIN — Phase 69+ ═════════════════
AI_TWO_AGENT_MODE=true           # Optimist+Critic two-agent synthesis
AI_BRAIN_CYCLE=3600              # AI brain cycle interval (seconds)
AI_BRAIN_FALLBACK_CHAIN=groq,claude  # Fallback provider order
AI_AUTO_CONFIDENCE=0.70          # Auto-apply threshold for AI suggestions
AI_MIN_TRADES=15                 # Min trades before AI can modify strategy

# ═════════════════ AUTO-RESUME (Phase 49) ═════════════════
AUTO_RESUME_ON_STARTUP=true      # Auto-resume paused strategies on boot
AUTO_RESUME_MIN_WR=48.0          # Min WR% to auto-resume
